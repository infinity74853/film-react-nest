FROM nginx:alpine

# Копируем обе конфигурации
COPY nginx.conf /etc/nginx/conf.d/default.dev.conf
COPY nginx.prod.conf /etc/nginx/conf.d/default.prod.conf

# Скрипт для автоматического выбора конфигурации
RUN echo '#!/bin/sh\n\
if [ -f "/etc/letsencrypt/live/igor-films.students.nomorepartiessbs.ru/fullchain.pem" ]; then\n\
    echo "Using production nginx config with SSL"\n\
    cp /etc/nginx/conf.d/default.prod.conf /etc/nginx/conf.d/default.conf\n\
else\n\
    echo "Using development nginx config"\n\
    cp /etc/nginx/conf.d/default.dev.conf /etc/nginx/conf.d/default.conf\n\
fi\n\
exec nginx -g "daemon off;"' > /docker-entrypoint.sh && \
    chmod +x /docker-entrypoint.sh

EXPOSE 80 443

CMD ["/docker-entrypoint.sh"]